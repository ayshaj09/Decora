<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkbrown"
    tools:context=".Page14Activity">


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginHorizontal="20dp"
        android:id="@+id/searching"
        android:layout_height="wrap_content">


        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/back_arrow"
            android:id="@+id/back"
            android:clickable="true"
            android:backgroundTint="@color/white"
            android:layout_gravity="center_vertical"/>

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/img_6"
            android:clickable="true"
            android:id="@+id/detail"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="5dp"
            android:backgroundTint="@color/white"
            android:layout_gravity="center_vertical"/>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/img_3"
            android:clickable="true"
            android:layout_toLeftOf="@id/detail"
            android:layout_centerVertical="true"
            android:layout_marginRight="10dp"
            android:backgroundTint="@color/white"/>



    </RelativeLayout>

    <ScrollView
        android:layout_centerHorizontal="true"
        android:id="@+id/scrollView"
        android:layout_below="@id/searching"
        android:layout_above="@+id/footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dining Tables"
                android:layout_marginLeft="25dp"
                android:layout_marginTop="40dp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="26dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 pins"
                android:layout_marginLeft="25dp"
                android:textColor="@color/grey"
                android:textSize="12dp"/>


        <RelativeLayout
            android:id="@+id/furnitureLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">




            <ImageView
                android:id="@+id/furniture1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/d1" />

            <TextView
                android:id="@+id/text1"
                android:layout_below="@id/furniture1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:text="9+ extravagant dining rooms"
                android:layout_marginLeft="4dp"
                android:textColor="@color/white" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/furniture1"
                android:layout_alignEnd="@id/furniture1"
                android:layout_marginLeft="13dp"
                android:layout_marginEnd="-13dp"
                android:layout_toRightOf="@id/text1"
                android:src="@drawable/sar" />


            <ImageView
                android:id="@+id/furniture2"
                android:layout_marginLeft="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/furniture1"
                android:src="@drawable/d2" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/furniture2"
                android:layout_marginLeft="-22dp"
                android:layout_toRightOf="@id/furniture2"
                android:src="@drawable/sar" />


            <ImageView
                android:id="@+id/furniture3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/d3"
                android:layout_below="@id/text1"
                android:layout_marginTop="7dp" />

            <ImageView
                android:id="@+id/icon3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/furniture3"
                android:layout_marginStart="-25dp"
                android:layout_toEndOf="@id/furniture3"
                android:src="@drawable/sar" />


            <ImageView
                android:id="@+id/furniture4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/furniture2"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="24dp"
                android:layout_toRightOf="@id/furniture3"
                android:src="@drawable/d4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/furniture4"
                android:layout_marginLeft="15dp"
                android:layout_marginBottom="-20dp"
                android:layout_toRightOf="@id/furniture3"
                android:text="wooden tables"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/furniture4"
                android:layout_alignEnd="@id/furniture4"
                android:src="@drawable/sar" />


            <ImageView
                android:id="@+id/furniture5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/d5"
                android:layout_below="@id/icon3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="wayfare"
                android:textSize="12sp"
                android:layout_below="@id/furniture5"
                android:textColor="@color/white" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/furniture5"
                android:layout_alignEnd="@id/furniture1"
                android:layout_marginLeft="13dp"
                android:layout_marginEnd="-13dp"
                android:layout_toRightOf="@id/text1"
                android:src="@drawable/sar" />


            <ImageView
                android:id="@+id/furniture6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/d4"
                android:layout_below="@id/furniture4"
                android:layout_toRightOf="@id/furniture3"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="30dp" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/sar"
                android:layout_alignEnd="@id/furniture6"
                android:layout_below="@id/furniture6" />


        </RelativeLayout>
        </LinearLayout>

    </ScrollView>


    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="40dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/home"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@drawable/tab1"
            app:tint="@color/white"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:clickable="true" />

        <ImageView
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:src="@drawable/search"
            app:tint="@color/white"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:clickable="true" />

        <ImageView
            android:id="@+id/post"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:src="@drawable/plus"
            app:tint="@color/white"
            android:layout_marginBottom="3dp"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:clickable="true" />

        <ImageView
            android:id="@+id/comment"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:src="@drawable/comment"
            app:tint="@color/white"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            android:clickable="true" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/prof"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:layout_marginTop="-3dp"
            android:src="@drawable/defaultpfp"
            android:clickable="true" />
    </LinearLayout>

</RelativeLayout>
