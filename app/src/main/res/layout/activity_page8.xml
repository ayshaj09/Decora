<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkbrown"
    tools:context=".Page8Activity">

    <RelativeLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/darkbrown">

        <!-- Back Arrow -->
        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/back_arrow"
            android:backgroundTint="@color/white"
            android:layout_marginStart="15dp"
            android:layout_marginTop="18dp" />

        <!-- Main Image -->
        <ImageView
            android:id="@+id/firstimage"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="50dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_image" />

        <!-- Top Navigation -->
        <LinearLayout
            android:id="@+id/topNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/firstimage"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="20dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/heartIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/img_2"
                app:tint="@color/white"
                android:layout_marginTop="5dp" />

            <TextView
                android:id="@+id/likeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="14dp" />

            <ImageView
                android:id="@+id/commentIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/img_5"
                app:tint="@color/white"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="14dp" />

            <ImageView
                android:id="@+id/uploadIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/img_3"
                app:tint="@color/white"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="14dp" />

            <ImageView
                android:id="@+id/saveIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/img_6"
                app:tint="@color/white"
                android:layout_marginTop="5dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/saveButton"
                android:layout_width="70dp"
                android:layout_height="35dp"
                android:text="Save"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/darkbrown"
                android:backgroundTint="@color/white"
                android:textSize="15sp"
                android:background="@drawable/textbox2" />
        </LinearLayout>

        <!-- User Section -->
        <LinearLayout
            android:id="@+id/userSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/topNavigation"
            android:layout_marginTop="10dp"
            android:layout_marginStart="25dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profilePic"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/defaultpfp" />

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Username"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Content Text -->
        <LinearLayout
            android:id="@+id/textSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/userSection"
            android:layout_marginTop="10dp"
            android:layout_marginStart="25dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elevate your space with excellence"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More to explore"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Furniture Layout -->
        <RelativeLayout
            android:id="@+id/furnitureLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/textSection"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/furniture3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/p2"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp" />

            <ImageView
                android:id="@+id/furniture4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/furniture3"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/p2" />

            <ImageView
                android:id="@+id/furniture5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/furniture4"
                android:layout_toRightOf="@id/furniture3"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:src="@drawable/furniture2" />
        </RelativeLayout>

        <!-- Comment Section -->
        <LinearLayout
            android:id="@+id/commentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/furnitureLayout"
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/commentsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Comments"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/commentInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Add a comment..."
                    android:textColor="@color/white"
                    android:textColorHint="#AAAAAA"
                    android:background="@null" />

                <TextView
                    android:id="@+id/postCommentBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Post"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginStart="15dp" />
            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>

</ScrollView>
