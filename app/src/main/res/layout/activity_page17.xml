<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2B241C"
    tools:context=".Page17Activity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:id="@+id/top"
        >

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginTop="10dp"
            android:id="@+id/back"
            android:clickable="true"
            android:background="@drawable/back_arrow"
            android:layout_marginHorizontal="25dp"
            android:backgroundTint="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Done"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginEnd="25dp"
            android:textSize="18dp"
            android:layout_marginTop="5dp"
            android:id="@+id/done"/>

    </RelativeLayout>

    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:id="@+id/pfp"
        android:layout_below="@id/top"
        android:src="@drawable/pfp2"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="45dp"
        />

    <TextView
        android:layout_width="60dp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/pfp"
        android:backgroundTint="#737576"
        android:text="Edit"
        android:gravity="center"
        android:textSize="16dp"
        android:clickable="true"
        android:id="@+id/edit"
        android:textColor="@color/white"
        android:background="@drawable/login_button"
        android:layout_marginTop="20dp"
        android:layout_height="30dp"/>

    <LinearLayout
        android:layout_width="380dp"
        android:layout_below="@id/edit"
        android:layout_marginTop="30dp"
        android:id="@+id/name"
        android:layout_centerHorizontal="true"
        android:background="@drawable/login_button"
        android:orientation="vertical"
        android:layout_height="55dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/white"/>

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="David Cohin"
            android:textStyle="bold"
            android:textSize="18sp"

            android:layout_marginStart="10dp"
            android:textColor="@color/white"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="380dp"
        android:layout_below="@id/name"
        android:layout_marginTop="15dp"
        android:id="@+id/username"
        android:layout_centerHorizontal="true"
        android:background="@drawable/login_button"
        android:orientation="vertical"
        android:layout_height="55dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/white"/>

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dvid"
            android:textStyle="bold"
            android:textSize="18sp"

            android:layout_marginStart="10dp"
            android:textColor="@color/white"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="380dp"
        android:layout_below="@id/username"
        android:layout_marginTop="15dp"
        android:id="@+id/email"
        android:layout_centerHorizontal="true"
        android:background="@drawable/login_button"
        android:orientation="vertical"
        android:layout_height="55dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/white"/>

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="david@gmail.com"
            android:textStyle="bold"
            android:textSize="18sp"

            android:layout_marginStart="10dp"
            android:textColor="@color/white"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="380dp"
        android:layout_below="@id/email"
        android:layout_marginTop="15dp"
        android:id="@+id/phno"
        android:layout_centerHorizontal="true"
        android:background="@drawable/login_button"
        android:orientation="vertical"
        android:layout_height="55dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/white"/>

        <EditText
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColorHint="@color/grey"
            android:textStyle="bold"
            android:textSize="18sp"

            android:layout_marginStart="10dp"
            android:textColor="@color/white"/>
    </LinearLayout>

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_below="@id/phno"
    android:text="About"
    android:id="@+id/about"
    android:textColor="@color/white"
    android:textStyle="bold"
    android:textSize="18dp"
    android:layout_marginTop="20dp"
    android:layout_marginStart="20dp"/>

    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_below="@id/about"
    android:text="Tell your story"
    android:textColor="#737576"
    android:textSize="18dp"
    android:layout_marginTop="10dp"
    android:layout_marginStart="20dp"/>





</RelativeLayout>