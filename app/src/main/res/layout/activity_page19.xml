<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#2B241C"
    tools:context=".Page19Activity">

    <!-- HEADER -->
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#FAFAFA">

        <ImageView
            android:id="@+id/back"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/back_arrow"
            android:backgroundTint="#ffffff"
            android:layout_centerVertical="true"
            android:layout_marginStart="20dp"
            android:clickable="true" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/pfp"
            android:clickable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/pfp2"
            android:layout_toEndOf="@id/back"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_toEndOf="@id/pfp"
            android:layout_marginStart="10dp"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/status"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/img_6"
            android:backgroundTint="@color/white"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="20dp"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <!-- CHAT INPUT BAR (Bottom) -->
    <LinearLayout
        android:id="@+id/message_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical|center_horizontal"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/camera"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginRight="15dp"
            android:backgroundTint="#ffffff"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/img" />

        <LinearLayout
            android:id="@+id/t"
            android:layout_width="340dp"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:background="@drawable/textbox2"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:background="@null"
                android:gravity="center_vertical"
                android:hint="Type a Message..."
                android:textColor="@color/white"
                android:textColorHint="#989898"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:id="@+id/send"
                android:clickable="true"
                android:layout_height="20dp"
                android:background="@drawable/back_arrow"
                android:backgroundTint="@color/white"
                android:rotationY="180"
                android:layout_marginEnd="15dp"
                />
        </LinearLayout>
    </LinearLayout>

    <!-- RECYCLER VIEW (Messages) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@id/message_bar"
        android:padding="10dp"
        android:clipToPadding="false"
        android:layout_marginBottom="10dp"/>

</RelativeLayout>